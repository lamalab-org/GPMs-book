\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cumulative token count based on the \texttt  {ChemPile} tabular datasets \blx@tocontentsinit {0}\autocite {mirza2025chempile0}}. We compare the approximate token count for three datasets: \texttt  {Llama-3} training dataset,\blx@tocontentsinit {0}\autocite {grattafiori2024llama} openly available chemistry papers in the \texttt  {ChemPile-Paper} dataset, and the \texttt  {ChemPile-LIFT} dataset. As can be seen, by aggregating the collection of tabular datasets converted to text format in the \texttt  {ChemPile-LIFT} subset, we can achieve the same order of magnitude as the collection of open chemistry papers. However, without smaller datasets, we cannot capture the breadth and complexity of chemistry data, which is essential for training \gls {gpm}. The tokenization method for both \texttt  {ChemPile} and \texttt  {Llama-3} is provided in the respective papers.}}{10}{figure.caption.7}\protected@file@percent }
\@gls@reference{acronym}{gpm}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{10}}
\newlabel{fig:scale_of_data}{{2}{10}{\textbf {Cumulative token count based on the \modelname {ChemPile} tabular datasets \autocite {mirza2025chempile0}}. We compare the approximate token count for three datasets: \modelname {Llama-3} training dataset,\autocite {grattafiori2024llama} openly available chemistry papers in the \modelname {ChemPile-Paper} dataset, and the \modelname {ChemPile-LIFT} dataset. As can be seen, by aggregating the collection of tabular datasets converted to text format in the \modelname {ChemPile-LIFT} subset, we can achieve the same order of magnitude as the collection of open chemistry papers. However, without smaller datasets, we cannot capture the breadth and complexity of chemistry data, which is essential for training \gls {gpm}. The tokenization method for both \modelname {ChemPile} and \modelname {Llama-3} is provided in the respective papers}{figure.caption.7}{}}
\newlabel{fig:scale_of_data@cref}{{[figure][2][]2}{[1][9][]10}{}{}{}}
