\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {State space description for chemistry at different scales}. We illustrate how the number of hidden variables (gray) is growing with scale and complexity. For simple systems\DIFaddbeginFL  {\color {blue}\uwave {, }}\DIFaddendFL  we can explicitly write down all variables \DIFdelbeginFL  {\color {red}\sout@orig {and }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {with }}\DIFaddendFL  their values and perfectly describe the system. For more complex systems---closer to practical applications---we can no longer do that. Many more variables cannot be explicitly enumerated.}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:shape_of_data}{{1}{8}{\textbf {State space description for chemistry at different scales}. We illustrate how the number of hidden variables (gray) is growing with scale and complexity. For simple systems\DIFaddbeginFL \DIFaddFL {, }\DIFaddendFL we can explicitly write down all variables \DIFdelbeginFL \DIFdelFL {and }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {with }\DIFaddendFL their values and perfectly describe the system. For more complex systems---closer to practical applications---we can no longer do that. Many more variables cannot be explicitly enumerated}{figure.caption.4}{}}
\newlabel{fig:shape_of_data@cref}{{[figure][1][]1}{[1][8][]8}{}{}{}}
