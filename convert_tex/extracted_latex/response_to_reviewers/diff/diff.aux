\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Comparison of measurement specificity and application relevance of chemistry benchmarks.} This figure presents a subjective, qualitative positioning of selected chemistry-related benchmarks along the axes of application relevance and measurement specificity (the extent to which a benchmark evaluates well-defined and objectively measurable outputs---such as physical or chemical properties---rather than more ambiguous tasks like answering general chemistry trivia or \gls {mcq}). The icons indicate whether a benchmark incorporates multimodal inputs (e.g., images or spectra), \DIFdelbeginFL  {\color {red}\sout@orig {when }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {if }}\DIFaddendFL  it is actively maintained (based on GitHub activity within the past 6 months), and if it supports end-to-end evaluation via a clearly described pipeline with code provided by the authors.}}{56}{figure.caption.41}\protected@file@percent }
\@gls@reference{acronym}{mcq}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{56}}
\newlabel{fig:benchmarks}{{8}{56}{\textbf {Comparison of measurement specificity and application relevance of chemistry benchmarks.} This figure presents a subjective, qualitative positioning of selected chemistry-related benchmarks along the axes of application relevance and measurement specificity (the extent to which a benchmark evaluates well-defined and objectively measurable outputs---such as physical or chemical properties---rather than more ambiguous tasks like answering general chemistry trivia or \gls {mcq}). The icons indicate whether a benchmark incorporates multimodal inputs (e.g., images or spectra), \DIFdelbeginFL \DIFdelFL {when }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {if }\DIFaddendFL it is actively maintained (based on GitHub activity within the past 6 months), and if it supports end-to-end evaluation via a clearly described pipeline with code provided by the authors}{figure.caption.41}{}}
\newlabel{fig:benchmarks@cref}{{[figure][8][]8}{[1][55][]56}{}{}{}}
