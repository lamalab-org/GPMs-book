\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Fine-tuned \texttt  {GPT-3} for predicting solid-solution formation in high-entropy alloys} Performance comparison of different \gls {ml} approaches as a function of the number of training points. Results are shown for \texttt  {Automatminer} (blue), \texttt  {CrabNet} transformer (orange), fine-tuned \texttt  {GPT-3} (red), with error bars showing standard error of the mean. The non-Google test set shows the fine-tuned \texttt  {GPT-3} model tested on compounds without an exact Google search match (dark red). The dashed line shows performance using random forest \DIFaddbeginFL  {\color {blue}\uwave {(RF)}}\DIFaddendFL  . \texttt  {GPT-3} achieves comparable accuracy to traditional approaches with \DIFdelbeginFL  {\color {red}\sout@orig {significantly }}\DIFdelendFL  fewer training examples. Data adapted from \blx@tocontentsinit {0}\textcite {jablonka2024leveraging}}}{108}{figure.caption.80}\protected@file@percent }
\@gls@reference{acronym}{ml}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{108}}
\newlabel{fig:gptchem}{{18}{108}{\textbf {Fine-tuned \modelname {GPT-3} for predicting solid-solution formation in high-entropy alloys} Performance comparison of different \gls {ml} approaches as a function of the number of training points. Results are shown for \modelname {Automatminer} (blue), \modelname {CrabNet} transformer (orange), fine-tuned \modelname {GPT-3} (red), with error bars showing standard error of the mean. The non-Google test set shows the fine-tuned \modelname {GPT-3} model tested on compounds without an exact Google search match (dark red). The dashed line shows performance using random forest \DIFaddbeginFL \DIFaddFL {(RF)}\DIFaddendFL . \modelname {GPT-3} achieves comparable accuracy to traditional approaches with \DIFdelbeginFL \DIFdelFL {significantly }\DIFdelendFL fewer training examples. Data adapted from \textcite {jablonka2024leveraging}}{figure.caption.80}{}}
\newlabel{fig:gptchem@cref}{{[figure][18][]18}{[1][107][]108}{}{}{}}
