\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {{\color {blue}\uwave {A. A representation of a typical agent for scientific queries.}}} {\color {blue}\uwave {The }}\gls {llm} {\color {blue}\uwave {is the central piece of the system, surrounded by typical tools that improve its question-answering capabilities, together forming an agentic system. The tools represented in this figure are semantic search, citation traversal, evidence gathering, and question answering. Semantic search finds relevant documents. Evidence gathering ranks and filters chunks of text using }}\glspl {llm}{\color {blue}\uwave {. The citation traversal tool provides model access to citation graphs, enabling accurate referencing of each chunk and facilitating the discovery of additional sources. Finally, the question-answering tool (an }}\gls {llm}{\color {blue}\uwave {) collects all the information found by other tools and generates a final response to a user's query. This part of the figure is inspired by the \texttt  {PaperQA2} agent.}}\blx@tocontentsinit {0}\autocite {skarlinski2024language} \textbf  {{\color {blue}\uwave {B.}}} {\color {blue}\uwave {Two examples of applications are discussed in this section. }}\textbf  {{\color {blue}\uwave {C.}}} {\color {blue}\uwave {worked example using the }}\texttt  {{\color {blue}\uwave {FutureHouse}}}{\color {blue}\uwave {'s platform (the Crow agent). }}\enquote {used in 1.1} {\color {blue}\uwave {indicates that this reference has been used in the final response of the model}}\blx@tocontentsinit {0}\autocite {skarlinski2025futurehouse}}}{72}{figure.caption.65}\protected@file@percent }
\@gls@reference{acronym}{llm}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{72}}
