\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The execution-cognition-perception capabilities of an \gls {llm}-agent:} This figure illustrates how agents orchestrate complex problems. At the core, an \gls {llm}-agent coordinates multiple capabilities. Upon prompting, the agent can execute tools. Tools include\DIFaddbeginFL  {\color {blue}\uwave {, }}\DIFaddendFL  but are not limited to\DIFaddbeginFL  {\color {blue}\uwave {, }}\DIFaddendFL  running code, searching for information, or calling functions. These actions feed into the agent's perception system, which transforms raw data into structured representations (in combination, for example, agents can obtain figures' information by executing \gls {ocr} tools on paper). The cognitive architecture underneath serves as the \enquote {agent's brain}, utilizing both memory systems (long-term knowledge storage and short-term contextual awareness) alongside reasoning mechanisms and planning strategies. This creates a dynamic setup, where execution produces observations, cognition interprets those observations and formulates plans, and new actions are taken based on improved understanding.}}{50}{figure.caption.32}\protected@file@percent }
\@gls@reference{acronym}{llm}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{50}}
\@gls@reference{acronym}{llm}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{50}}
\@gls@reference{acronym}{ocr}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{50}}
\newlabel{fig:agent-loop}{{7}{50}{\textbf {The execution-cognition-perception capabilities of an \gls {llm}-agent:} This figure illustrates how agents orchestrate complex problems. At the core, an \gls {llm}-agent coordinates multiple capabilities. Upon prompting, the agent can execute tools. Tools include\DIFaddbeginFL \DIFaddFL {, }\DIFaddendFL but are not limited to\DIFaddbeginFL \DIFaddFL {, }\DIFaddendFL running code, searching for information, or calling functions. These actions feed into the agent's perception system, which transforms raw data into structured representations (in combination, for example, agents can obtain figures' information by executing \gls {ocr} tools on paper). The cognitive architecture underneath serves as the \enquote {agent's brain}, utilizing both memory systems (long-term knowledge storage and short-term contextual awareness) alongside reasoning mechanisms and planning strategies. This creates a dynamic setup, where execution produces observations, cognition interprets those observations and formulates plans, and new actions are taken based on improved understanding}{figure.caption.32}{}}
\newlabel{fig:agent-loop@cref}{{[figure][7][]7}{[1][50][]50}{}{}{}}
